# ==============================
# AI Provider API Keys
# ==============================
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
TELNYX_API_KEY=
TELNYX_SPEAK_VOICE=female
TELNYX_MEDIA_WS_URL=

# Qwen ASR WebSocket server (Kaggle tunnel). Required only when STT_PROVIDER=qwen.
QWEN_ASR_WS_URL=
QWEN_ASR_API_KEY=

# Microsoft MAI-Transcribe-2-Streaming realtime STT (Azure AI).
# Required only when STT_PROVIDER=mai or a session selects stt_provider="mai".
# MAI_STT_RESOURCE_URL is the resource root, e.g.
# https://<resource-name>.services.ai.azure.com (no path).
MAI_STT_API_KEY=
MAI_STT_RESOURCE_URL=
MAI_STT_DEPLOYMENT=MAI-Transcribe-2-Streaming

# ==============================
# Default Provider Selections
# ==============================
DEFAULT_STT_PROVIDER=deepgram
DEFAULT_STT_MODEL=nova-3

# Realtime streaming STT provider: deepgram (default) | qwen | mai
STT_PROVIDER=deepgram

DEFAULT_LLM_PROVIDER=openrouter
DEFAULT_LLM_MODEL=

DEFAULT_TTS_PROVIDER=elevenlabs
DEFAULT_TTS_MODEL=eleven_flash_v2_5
DEFAULT_TTS_VOICE=JBFqnCBsd6RMkjVDRZzb

# ==============================
# Azure AI Speech TTS (optional provider)
# ==============================
# Required only when DEFAULT_TTS_PROVIDER=azure or a turn-based session
# selects tts_provider="azure". The default TTS provider stays elevenlabs.
# To switch the server TTS path to Azure:
#   DEFAULT_TTS_PROVIDER=azure
#   DEFAULT_TTS_VOICE=            (empty, so AZURE_TTS_VOICE is used)
# The voice must be an Azure neural voice available in the region.
AZURE_TTS_KEY=
AZURE_TTS_REGION=eastus
AZURE_TTS_VOICE=en-US-JennyNeural

# ==============================
# Provider Timeouts (seconds)
# ==============================
STT_TIMEOUT=30.0
LLM_TIMEOUT=60.0
TTS_TIMEOUT=30.0

# ==============================
# Agent Runtime
# ==============================
MAX_AGENT_ITERATIONS=5
MAX_CONVERSATION_MESSAGES=50

# ==============================
# Database
# ==============================
DATABASE_URL=sqlite:///./voice_ai_lab.db

# ==============================
# Application
# ==============================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ==============================
# CORS
# ==============================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
